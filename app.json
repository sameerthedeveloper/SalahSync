{
  "expo": {
    "name": "SalahSync",
    "slug": "salahsync",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "salahsync",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.sameerthedeveloper.salahsync",
      "icon": "./assets/expo.icon",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.sameerthedeveloper.salahsync",
      "adaptiveIcon": {
        "backgroundColor": "#065F46",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#065F46",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "SalahSync uses the camera to photograph your mosque's prayer timetable."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "SalahSync reads a timetable image you choose from your photo library."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "SalahSync uses your location only to identify which mosque a timetable belongs to."
        }
      ],
      "./plugins/withoutPushEntitlement",
      "./plugins/withSceneLifecycle"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
